generator client {
  provider      = "prisma-client-js"
  // native = local/dev; rhel-openssl-3.0.x = Netlify Functions (AWS Lambda)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoConta {
  Corrente
  Poupanca
  Dinheiro
  CartaoCredito
}

enum PilarCategoria {
  Sobrevivencia
  Lazer
  Cultura
  Extras
}

enum TipoLancamento {
  Receita
  Despesa
  Transferencia
}

enum StatusTransacao {
  Pendente
  Pago
}

enum StatusFatura {
  Aberta
  Fechada
  ParcialmentePaga
  Paga
  Vencida
}

enum DirecaoTransferencia {
  Entrada
  Saida
}

model Usuario {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  senha_hash   String
  data_criacao DateTime @default(now())

  contas                 ContaBancaria[]
  categorias             Categoria[]
  orcamentos             Orcamento[]
  transacoes             Transacao[]
  faturas_cartao         FaturaCartao[]
  pagamentos_fatura      PagamentoFatura[]
  transferencias_grupo   TransferenciaGrupo[]
  auditorias_financeiras AuditoriaFinanceira[]
  veiculos              UserVehicle[]
  fuel_scenarios         FuelScenario[]
  fuel_budget_allocations FuelScenarioBudgetAllocation[]
  fuel_cashflow_forecasts FuelScenarioCashflowForecast[]
  fuel_prices            FuelPrice[]
  planejamentos_salariais PlanejamentoSalarial[]

  @@map("usuarios")
}

model ContaBancaria {
  id            String    @id @default(uuid())
  usuario_id    String
  nome          String
  tipo          TipoConta
  saldo_inicial Decimal   @db.Decimal(10, 2)
  saldo_atual   Decimal   @db.Decimal(10, 2)

  usuario           Usuario                @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  cartao_detalhe    CartaoCreditoDetalhe?
  cartoes_pagamento CartaoCreditoDetalhe[] @relation("ContaPagamentoPadrao")
  transacoes_origem Transacao[]            @relation("ContaOrigem")
  faturas_cartao    FaturaCartao[]
  planejamentos_salariais PlanejamentoSalarial[]

  @@index([usuario_id, tipo])
  @@index([usuario_id, nome])
  @@map("contas_bancarias")
}

model CartaoCreditoDetalhe {
  id                        String  @id @default(uuid())
  conta_id                  String  @unique
  limite_total              Decimal @db.Decimal(10, 2)
  dia_fechamento            Int
  dia_vencimento            Int
  conta_pagamento_padrao_id String? // Conta bancária padrão para pagar a fatura

  conta           ContaBancaria  @relation(fields: [conta_id], references: [id], onDelete: Cascade)
  conta_pagamento ContaBancaria? @relation("ContaPagamentoPadrao", fields: [conta_pagamento_padrao_id], references: [id], onDelete: SetNull)

  @@map("cartoes_credito_detalhes")
}

model Categoria {
  id         String         @id @default(uuid())
  usuario_id String
  nome       String
  pilar      PilarCategoria
  tipo       TipoLancamento

  usuario       Usuario        @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  subcategorias Subcategoria[]

  @@index([usuario_id, tipo])
  @@map("categorias")
}

model Subcategoria {
  id           String @id @default(uuid())
  categoria_id String
  nome         String

  categoria      Categoria      @relation(fields: [categoria_id], references: [id], onDelete: Cascade)
  orcamentos     Orcamento[]
  transacoes     Transacao[]
  fuel_scenarios FuelScenario[]
  fuel_budget_allocations FuelScenarioBudgetAllocation[]
  planejamentos_salariais PlanejamentoSalarial[]

  @@index([categoria_id])
  @@map("subcategorias")
}

model Orcamento {
  id              String  @id @default(uuid())
  usuario_id      String
  subcategoria_id String
  mes             Int
  ano             Int
  valor_orcado    Decimal @db.Decimal(10, 2)

  usuario      Usuario      @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  subcategoria Subcategoria @relation(fields: [subcategoria_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, subcategoria_id, mes, ano])
  @@index([usuario_id, ano, mes])
  @@map("orcamentos")
}

model FuelScenario {
  id                       String   @id @default(uuid())
  usuario_id               String
  nome                     String?
  descricao                String?
  user_vehicle_id          String?
  fuel_type                String?
  weekdays                 Int[]    @default([])
  origin_label             String?
  origin_lat               Decimal? @db.Decimal(10, 7)
  origin_lng               Decimal? @db.Decimal(10, 7)
  destination_label        String?
  destination_lat          Decimal? @db.Decimal(10, 7)
  destination_lng          Decimal? @db.Decimal(10, 7)
  outbound_distance_km     Decimal  @db.Decimal(10, 3)
  return_distance_km       Decimal  @db.Decimal(10, 3)
  outbound_duration_min    Decimal? @db.Decimal(8, 2)
  return_duration_min      Decimal? @db.Decimal(8, 2)
  days_per_week            Decimal  @db.Decimal(4, 2)
  weeks_per_month          Decimal  @db.Decimal(4, 2)
  extra_days               Int      @default(0)
  extra_margin_percent     Decimal  @default(0) @db.Decimal(5, 2)
  fuel_efficiency_km_per_l Decimal  @db.Decimal(10, 3)
  fuel_price_per_l         Decimal  @db.Decimal(10, 3)
  monthly_distance_km      Decimal  @db.Decimal(10, 3)
  monthly_cost             Decimal  @db.Decimal(12, 2)
  suggested_budget         Decimal  @db.Decimal(12, 2)
  annual_cost              Decimal  @db.Decimal(12, 2)
  forecast_type            String
  mapped_subcategoria_id   String?
  mapped_mes               Int?
  mapped_ano               Int?
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  usuario    Usuario       @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  vehicle    UserVehicle?  @relation(fields: [user_vehicle_id], references: [id], onDelete: SetNull)
  mapped_sub Subcategoria? @relation(fields: [mapped_subcategoria_id], references: [id], onDelete: SetNull)
  budget_allocations FuelScenarioBudgetAllocation[]
  cashflow_forecasts FuelScenarioCashflowForecast[]

  @@index([usuario_id, created_at])
  @@map("fuel_scenarios")
}

model UserVehicle {
  id                         String   @id @default(uuid())
  usuario_id                 String
  nome                       String
  marca                      String?
  modelo                     String?
  ano                        Int?
  fuel_type                  String
  city_efficiency_km_per_l   Decimal  @db.Decimal(10, 3)
  highway_efficiency_km_per_l Decimal @db.Decimal(10, 3)
  ativo                      Boolean  @default(true)
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  scenarios FuelScenario[]

  @@index([usuario_id, ativo])
  @@map("user_vehicles")
}

model FuelPrice {
  id          String   @id @default(uuid())
  usuario_id  String
  fuel_type   String
  price_per_l Decimal  @db.Decimal(10, 3)
  updated_at  DateTime @updatedAt

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, fuel_type])
  @@map("fuel_prices")
}

model FuelScenarioBudgetAllocation {
  id               String   @id @default(uuid())
  usuario_id       String
  fuel_scenario_id String
  subcategoria_id  String
  mes              Int
  ano              Int
  valor_orcado     Decimal  @db.Decimal(12, 2)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  scenario FuelScenario @relation(fields: [fuel_scenario_id], references: [id], onDelete: Cascade)
  subcategoria Subcategoria @relation(fields: [subcategoria_id], references: [id], onDelete: Cascade)

  @@unique([fuel_scenario_id, mes, ano])
  @@index([usuario_id, ano, mes])
  @@map("fuel_scenario_budget_allocations")
}

model FuelScenarioCashflowForecast {
  id               String   @id @default(uuid())
  usuario_id       String
  fuel_scenario_id String
  transacao_id     String   @unique
  mes              Int
  ano              Int
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  scenario FuelScenario @relation(fields: [fuel_scenario_id], references: [id], onDelete: Cascade)
  transacao Transacao @relation(fields: [transacao_id], references: [id], onDelete: Cascade)

  @@unique([fuel_scenario_id, mes, ano])
  @@index([usuario_id, ano, mes])
  @@map("fuel_scenario_cashflow_forecasts")
}

model Transacao {
  id                     String                @id @default(uuid())
  usuario_id             String
  conta_id               String
  subcategoria_id        String?
  descricao              String
  valor                  Decimal               @db.Decimal(10, 2)
  tipo                   TipoLancamento
  data_transacao         DateTime
  status                 StatusTransacao
  parcela_atual          Int                   @default(1)
  total_parcelas         Int                   @default(1)
  transacao_pai_id       String? // Para agrupar compras parceladas
  recorrente             Boolean               @default(false) // Para identificar compras recorrentes / assinaturas
  fatura_id              String?
  transferencia_grupo_id String?
  transferencia_direcao  DirecaoTransferencia?

  usuario                  Usuario             @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  conta                    ContaBancaria       @relation("ContaOrigem", fields: [conta_id], references: [id], onDelete: Cascade)
  subcategoria             Subcategoria?       @relation(fields: [subcategoria_id], references: [id], onDelete: SetNull)
  fatura                   FaturaCartao?       @relation(fields: [fatura_id], references: [id], onDelete: SetNull)
  transferencia_grupo      TransferenciaGrupo? @relation(fields: [transferencia_grupo_id], references: [id], onDelete: SetNull)
  pagamento_fatura_saida   PagamentoFatura?    @relation("PagamentoFaturaSaida")
  pagamento_fatura_entrada PagamentoFatura?    @relation("PagamentoFaturaEntrada")
  fuel_cashflow_forecast   FuelScenarioCashflowForecast?
  planejamento_salarial_lancamento PlanejamentoSalarialLancamento?

  @@index([fatura_id])
  @@index([transferencia_grupo_id])
  @@index([usuario_id, data_transacao])
  @@index([usuario_id, conta_id, data_transacao])
  @@index([usuario_id, status, data_transacao])
  @@index([transacao_pai_id])
  @@map("transacoes")
}

model PlanejamentoSalarial {
  id                         String   @id @default(uuid())
  usuario_id                 String
  empresa                    String
  ano                        Int
  salario_base               Decimal  @db.Decimal(12, 2)
  conta_id                   String
  subcategoria_id            String
  pagamento_folha            String   @default("seguinte")
  estimar_dezembro_anterior  Boolean  @default(true)
  incluir_decimo_terceiro    Boolean  @default(true)
  avos_decimo_terceiro       Int      @default(12)
  modo_decimo_terceiro       String   @default("duas")
  mes_primeira_parcela_13    Int      @default(11)
  mes_segunda_parcela_13     Int      @default(12)
  descontos_mensais          Decimal  @default(0) @db.Decimal(12, 2)
  vale_alimentacao           Decimal  @default(0) @db.Decimal(12, 2)
  odontologico               Decimal  @default(0) @db.Decimal(12, 2)
  assistencia_medica         Decimal  @default(0) @db.Decimal(12, 2)
  outros_descontos           Decimal  @default(0) @db.Decimal(12, 2)
  dependentes                Int      @default(0)
  melhor_deducao_irrf        Boolean  @default(true)
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt

  usuario       Usuario                         @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  conta         ContaBancaria                   @relation(fields: [conta_id], references: [id], onDelete: Cascade)
  subcategoria  Subcategoria                    @relation(fields: [subcategoria_id], references: [id], onDelete: Restrict)
  ferias        PlanejamentoSalarialFerias[]
  bonus         PlanejamentoSalarialBonus[]
  lancamentos   PlanejamentoSalarialLancamento[]

  @@index([usuario_id, ano])
  @@map("planejamentos_salariais")
}

model PlanejamentoSalarialFerias {
  id                  String   @id @default(uuid())
  planejamento_id     String
  inicio              DateTime
  fim                 DateTime
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  planejamento PlanejamentoSalarial @relation(fields: [planejamento_id], references: [id], onDelete: Cascade)

  @@index([planejamento_id, inicio])
  @@map("planejamentos_salariais_ferias")
}

model PlanejamentoSalarialBonus {
  id                  String   @id @default(uuid())
  planejamento_id     String
  mes                 Int
  valor               Decimal  @db.Decimal(12, 2)
  incide_inss         Boolean  @default(false)
  incide_irrf         Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  planejamento PlanejamentoSalarial @relation(fields: [planejamento_id], references: [id], onDelete: Cascade)

  @@unique([planejamento_id, mes])
  @@map("planejamentos_salariais_bonus")
}

model PlanejamentoSalarialLancamento {
  id              String   @id @default(uuid())
  planejamento_id String
  transacao_id    String   @unique
  competencia     String
  tipo_evento     String
  valor           Decimal  @db.Decimal(12, 2)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  planejamento PlanejamentoSalarial @relation(fields: [planejamento_id], references: [id], onDelete: Cascade)
  transacao    Transacao             @relation(fields: [transacao_id], references: [id], onDelete: Cascade)

  @@unique([planejamento_id, competencia, tipo_evento], map: "psl_lancamento_competencia_evento_key")
  @@index([planejamento_id, competencia], map: "psl_lancamento_competencia_idx")
  @@map("planejamentos_salariais_lancamentos")
}

model FaturaCartao {
  id              String       @id @default(uuid())
  usuario_id      String
  cartao_id       String
  competencia     String
  data_inicio     DateTime
  data_fim        DateTime
  data_fechamento DateTime
  data_vencimento DateTime
  status          StatusFatura @default(Aberta)
  total           Decimal      @default(0) @db.Decimal(10, 2)
  total_pago      Decimal      @default(0) @db.Decimal(10, 2)
  data_criacao    DateTime     @default(now())

  usuario    Usuario           @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  cartao     ContaBancaria     @relation(fields: [cartao_id], references: [id], onDelete: Cascade)
  transacoes Transacao[]
  pagamentos PagamentoFatura[]

  @@unique([cartao_id, competencia])
  @@index([usuario_id, status])
  @@map("faturas_cartao")
}

model PagamentoFatura {
  id                   String   @id @default(uuid())
  usuario_id           String
  fatura_id            String
  valor                Decimal  @db.Decimal(10, 2)
  data_pagamento       DateTime
  transacao_saida_id   String?  @unique
  transacao_entrada_id String?  @unique
  data_criacao         DateTime @default(now())

  usuario           Usuario      @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  fatura            FaturaCartao @relation(fields: [fatura_id], references: [id], onDelete: Cascade)
  transacao_saida   Transacao?   @relation("PagamentoFaturaSaida", fields: [transacao_saida_id], references: [id])
  transacao_entrada Transacao?   @relation("PagamentoFaturaEntrada", fields: [transacao_entrada_id], references: [id])

  @@index([fatura_id, data_pagamento])
  @@map("pagamentos_fatura")
}

model TransferenciaGrupo {
  id           String   @id @default(uuid())
  usuario_id   String
  descricao    String?
  data_criacao DateTime @default(now())

  usuario    Usuario     @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  transacoes Transacao[]

  @@index([usuario_id])
  @@map("transferencias_grupo")
}

model AuditoriaFinanceira {
  id           String   @id @default(uuid())
  usuario_id   String?
  request_id   String?
  acao         String
  entidade     String
  entidade_id  String?
  dados        Json?
  data_criacao DateTime @default(now())

  usuario Usuario? @relation(fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([usuario_id, data_criacao])
  @@index([entidade, entidade_id])
  @@index([request_id])
  @@map("auditorias_financeiras")
}
