# Backend / Netlify Functions
# Gere um JWT forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
NODE_ENV=production
PORT=3000

# PostgreSQL (Neon, Supabase, Railway, etc.)
# Em serverless use a connection string com pooling (ex.: Neon "pooled")
DATABASE_URL=link_postgresql_do_seu_banco_de_dados

# Opcional
# LOG_LEVEL=info
# CORS_ORIGIN=https://seu-app.netlify.app
# METRICS_TOKEN=gere-um-token-aleatorio-para-o-coletor-prometheus
# RATE_LIMIT_MAX=300

# Recuperacao de senha por SMTP (exemplo: conta Outlook.com)
# Use uma senha de aplicativo; nunca a senha principal da caixa.
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=seu-email@outlook.com
# SMTP_PASSWORD=senha-de-aplicativo
# EMAIL_FROM=Kakebo <seu-email@outlook.com>
# APP_URL=https://seu-app.netlify.app

# Provedores de mapas (opcionais; os valores públicos são usados por padrão)
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# NOMINATIM_USER_AGENT=Kakebo/1.0 (contato@seu-dominio.com)
# OSRM_BASE_URL=https://router.project-osrm.org
