PORT=3000

# PostgreSQL (Neon, Supabase, Railway, etc.)
# Em serverless use a connection string com pooling (ex.: Neon "pooled")
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

